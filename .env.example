# Frontend Supabase settings
# Copy the values you need into .env.local for Next.js local development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend runtime settings
# Copy this file to .env for the Python API if you want backend-side env loading.
EXPENSHILO_ARTIFACT_PATH=backend/artifacts/expenshilo_artifact.pkl
FINSIGHT_STORE_BACKEND=memory
FINSIGHT_AUTH_MODE=disabled

# Shared Supabase settings for backend auth and persistence
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional backend configuration
SUPABASE_DB_SCHEMA=public
SUPABASE_HTTP_TIMEOUT_SECONDS=10

# Experiment configuration
FINSIGHT_EXPERIMENT_NAME=assessment_explanation
FINSIGHT_EXPERIMENT_VERSION=v1
FINSIGHT_EXPERIMENT_ARMS=control,structured_explanation,llm_explanation
