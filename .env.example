# Frontend Supabase settings
# Copy the values you need into .env.local for Next.js local development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_ASSESSMENT_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend runtime settings
# Copy this file to .env for the Python API if you want backend-side env loading.
EXPENSHILO_ARTIFACT_PATH=backend/artifacts/expenshilo_artifact.pkl
FINSIGHT_STORE_BACKEND=memory
FINSIGHT_AUTH_MODE=disabled

# Shared Supabase settings for backend auth and persistence
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic / Claude explanation settings
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_TIMEOUT_SECONDS=20
FINSIGHT_LLM_PROMPT_VERSION=anthropic_explanation_v1
FINSIGHT_LLM_MAX_TOKENS=360

# Optional backend configuration
SUPABASE_DB_SCHEMA=public
SUPABASE_HTTP_TIMEOUT_SECONDS=10
# Add the deployed Vercel origin here for production, with no trailing slash.
FINSIGHT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-app.vercel.app
FINSIGHT_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$

# Experiment configuration
FINSIGHT_EXPERIMENT_NAME=assessment_explanation
FINSIGHT_EXPERIMENT_VERSION=v1
FINSIGHT_EXPERIMENT_ARMS=control,structured_explanation,llm_explanation
